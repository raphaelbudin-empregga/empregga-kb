    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/ui": "^4.1.10",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.9",
    "eslint": "^10",
    "eslint-config-next": "^16.2.12",
    "fast-check": "^4.9.0",
    "husky": "^9.1.7",
    "jsdom": "^30.0.0",
    "lint-staged": "^17.2.0",
    "msw": "^2.15.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4",
    "typescript": "^7",
    "vitest": "^4.1.10"
